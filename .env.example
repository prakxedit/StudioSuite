# ============================================================
# SKYSUITE - Environment Variables Configuration
# ============================================================

# Supabase Project URL (Client & API)
VITE_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anonymous / Publishable Key (Safe for browser)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note: Never expose Supabase service-role secret keys or DB passwords in frontend environments.
